# Copy to .env (all modes) or .env.dev / .env.production (one mode).
# Read by pkg/env in the Go app; the process environment overrides both.
LIDZA_ADDR=127.0.0.1:3000
# LIDZA_TLS_DOMAINS=app.example.com   # production: serve HTTPS on 443 with Let's Encrypt, redirect 80; APP_URL and AUTH_COOKIE_SECURE follow
# LIDZA_TLS_EMAIL=ops@example.com     # ACME account contact

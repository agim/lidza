package tests

import (
	"io"
	"net/http"
	"strings"
	"testing"

	"github.com/agim/lidza/pkg/lidzatest"

	"__LIDZA_APP_NAME__/app"
)

// The pages are Go templates served by the binary: a browser is not
// needed to test them. lidzatest.Start boots the app; `lidza test` runs
// this.
func TestPages(t *testing.T) {
	srv := lidzatest.Start(t, app.New(nil))
	get := func(path string) (int, string) {
		t.Helper()
		res, err := srv.Client().Get(srv.URL + path)
		if err != nil {
			t.Fatal(err)
		}
		defer res.Body.Close()
		body, _ := io.ReadAll(res.Body)
		return res.StatusCode, string(body)
	}
	if code, body := get("/"); code != http.StatusOK || !strings.Contains(body, "<title>__LIDZA_APP_NAME__</title>") || !strings.Contains(body, `hx-get="/partials/hello"`) {
		t.Fatalf("home: %d %s", code, body)
	}
	if code, body := get("/partials/hello?name=test"); code != http.StatusOK || !strings.Contains(body, "hello, test") {
		t.Fatalf("partial: %d %s", code, body)
	}
	if code, _ := get("/about"); code != http.StatusOK {
		t.Fatalf("about: %d", code)
	}
	// Every view has an address: the list's filter, an item by its slug,
	// its tab; the back link is a link to the parent (static/back.js
	// makes it go back when the previous page is this site's).
	if code, body := get("/items?category=seating"); code != http.StatusOK || !strings.Contains(body, "Oak chair") || strings.Contains(body, "Desk lamp") || !strings.Contains(body, `value="seating" selected`) {
		t.Fatalf("filtered list: %d %s", code, body)
	}
	if code, body := get("/items/desk-lamp/specs"); code != http.StatusOK || !strings.Contains(body, "<title>Specs · Desk lamp · __LIDZA_APP_NAME__</title>") || !strings.Contains(body, `<a href="/items" class="back" data-back>`) || !strings.Contains(body, "Bulb") {
		t.Fatalf("item tab: %d %s", code, body)
	}
	if code, body := get("/items/no-such-item"); code != http.StatusNotFound || !strings.Contains(body, "No item at this address") {
		t.Fatalf("unknown item: %d %s", code, body)
	}
	if code, _ := get("/static/back.js"); code != http.StatusOK {
		t.Fatalf("back.js: %d", code)
	}
}

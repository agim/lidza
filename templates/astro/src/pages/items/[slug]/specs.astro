---
// The specs tab of an item: /items/<slug>/specs.
import Base from '../../../layouts/Base.astro'
import BackLink from '../../../components/BackLink.astro'
import { items, type Item } from '../../../items'

export function getStaticPaths() {
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}
const { item } = Astro.props as { item: Item }
---

<Base title={`Specs · ${item.name}`}>
  <BackLink href="/items" class="back">All items</BackLink>
  <h1>{item.name}</h1>
  <nav aria-label="Item sections" class="tabs">
    <a href={`/items/${item.slug}`}>Overview</a>
    <a href={`/items/${item.slug}/specs`} aria-current="page">Specs</a>
  </nav>
  <dl>
    {
      item.specs.map((s) => (
        <>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </>
      ))
    }
  </dl>
</Base>

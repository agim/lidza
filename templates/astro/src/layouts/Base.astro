---
interface Props {
  title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      :root { font-family: system-ui, sans-serif; line-height: 1.5; color: #2a2224; background: #f8f4ef; }
      body { margin: 0; }
      nav { display: flex; gap: 1rem; padding: 0.75rem 1.5rem; border-bottom: 1px solid #e0d6cb; }
      nav a { color: #2a2224; text-decoration: none; }
      main { max-width: 48rem; margin: 0 auto; padding: 1.5rem; }
      pre { padding: 1rem; background: #ece4db; border-radius: 4px; overflow-x: auto; }
      .error { color: #b3261e; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
    </nav>
    <main>
      <slot />
    </main>
    <script>
      // Tells the server the visitor's time zone (tz cookie, read by the
      // i18n pack) and, with PUBLIC_ANALYTICS=1, reports errors and
      // pageviews to the analytics pack.
      import { announceTimezone } from '../timezone'
      import { enableAnalytics } from '../analytics'

      announceTimezone()
      if (import.meta.env.PUBLIC_ANALYTICS === '1') enableAnalytics()
    </script>
  </body>
</html>

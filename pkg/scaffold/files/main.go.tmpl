package main

import (
{{- if .Dist}}
	"embed"

{{- end}}
	"github.com/agim/lidza"

	"{{.Name}}/app"
)
{{if .Dist}}
// The production binary carries the frontend build. `lidza build` fills
// {{.Dist}}/ before compiling; in dev the frontend is proxied instead.
//
//go:embed all:{{.Dist}}
var dist embed.FS
{{end}}
func main() { lidza.Run(app.New({{if .Dist}}lidza.Sub(dist, "{{.Dist}}"){{else}}nil{{end}})) }

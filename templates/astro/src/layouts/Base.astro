---
interface Props {
  /** The page's own title; the app's name follows it ("Specs · Desk lamp · app"). */
  title?: string
}
const appName = '__LIDZA_APP_NAME__'
const { title } = Astro.props
const fullTitle = title && title !== appName ? `${title} · ${appName}` : appName
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <style is:global>
      :root { font-family: system-ui, sans-serif; line-height: 1.5; color: #2a2224; background: #f8f4ef; }
      body { margin: 0; }
      nav { display: flex; gap: 1rem; padding: 0.75rem 1.5rem; border-bottom: 1px solid #e0d6cb; }
      nav a { color: #2a2224; text-decoration: none; }
      main { max-width: 48rem; margin: 0 auto; padding: 1.5rem; }
      pre { padding: 1rem; background: #ece4db; border-radius: 4px; overflow-x: auto; }
      .error { color: #b3261e; }
      .back { color: #6b5f62; font-size: 0.875rem; }
      .tabs { padding: 0; }
      .tabs a[aria-current='page'] { font-weight: 600; border-bottom: 2px solid #8a2c5a; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/items">Items</a>
      <a href="/about">About</a>
    </nav>
    <main>
      <slot />
    </main>
    <script>
      // Tells the server the visitor's time zone (tz cookie, read by the
      // i18n pack), makes back links go back (src/back.ts) and, with
      // PUBLIC_ANALYTICS=1, reports errors and pageviews to the analytics
      // pack.
      import { announceTimezone } from '../timezone'
      import { enhanceBackLinks } from '../back'
      import { enableAnalytics } from '../analytics'

      announceTimezone()
      enhanceBackLinks()
      if (import.meta.env.PUBLIC_ANALYTICS === '1') enableAnalytics()
    </script>
  </body>
</html>

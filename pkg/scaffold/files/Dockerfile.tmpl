# syntax=docker/dockerfile:1
# Builds {{.Name}} into one static binary and runs it from a minimal image.
# The builder has Go and Node; `lidza build` builds the frontend, embeds it
# and compiles the binary. Rust packs need the toolchain too: see the
# commented lines. The go.mod of an app created with --lidza-dir points at
# a local checkout; replace that with a published version before building.

FROM golang:{{.Go}}-bookworm AS build
ENV CGO_ENABLED=0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*
# Rust packs (packs/<name>/rust): uncomment.
# RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal -t wasm32-wasip1
# ENV PATH=/root/.cargo/bin:$PATH
RUN go install {{.Module}}/cmd/lidza@{{.LidzaVersion}}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
{{- if .Dist}}
COPY package.json package-lock.json* ./
RUN npm ci --no-fund --no-audit || npm install --no-fund --no-audit
{{- end}}
COPY . .
RUN mkdir -p db && lidza build --out /out/{{.Name}}

# Runtime: the binary, the migrations (applied with DB_MIGRATE=true or
# `lidza db migrate`), nothing else. Per-request SSR (LIDZA_SSR=1) needs
# Node at runtime: use node:22-bookworm-slim here instead and copy dist/.server.
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/{{.Name}} /app/{{.Name}}
COPY --from=build /src/db /app/db
ENV LIDZA_ADDR=0.0.0.0:3000
EXPOSE 3000
ENTRYPOINT ["/app/{{.Name}}"]

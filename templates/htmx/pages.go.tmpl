package app

import (
	"embed"
	"html/template"
	"io/fs"
	"log/slog"
	"net/http"
	"os"

	"github.com/agim/lidza/pkg/router"
)

// Views and static files ship inside the binary. `lidza dev` rebuilds when
// they change (lidza.json "watch").
//
//go:embed views static
var assets embed.FS

// Each page is layout.html plus its own file, which defines "content".
// Partials are fragments htmx swaps into the page.
var (
	// lidza:ignore L001 (filled once at start, read only after)
	pageTemplates = map[string]*template.Template{
		"index": template.Must(template.ParseFS(assets, "views/layout.html", "views/index.html")),
		"about": template.Must(template.ParseFS(assets, "views/layout.html", "views/about.html")),
		"items": template.Must(template.ParseFS(assets, "views/layout.html", "views/items.html")),
		"item":  template.Must(template.ParseFS(assets, "views/layout.html", "views/item.html")),
	}
	partials = template.Must(template.ParseFS(assets, "views/partials/*.html"))
)

// pages serves everything outside /api: full pages, htmx partials and
// static files.
func pages() http.Handler {
	mux := http.NewServeMux()
	static, err := fs.Sub(assets, "static")
	if err != nil {
		panic(err) // static is embedded above: only a mistyped name fails
	}
	mux.Handle("GET /static/", http.StripPrefix("/static/", http.FileServerFS(static)))
	// /llms.txt for visiting agents, from static/llms.txt (lidza gen
	// llms writes it); a 404 until it exists.
	mux.HandleFunc("GET /llms.txt", func(w http.ResponseWriter, r *http.Request) {
		http.ServeFileFS(w, r, static, "llms.txt")
	})
	mux.HandleFunc("GET /{$}", func(w http.ResponseWriter, r *http.Request) {
		renderPage(w, "index", map[string]any{"Title": "__LIDZA_APP_NAME__"})
	})
	mux.HandleFunc("GET /about", func(w http.ResponseWriter, r *http.Request) {
		renderPage(w, "about", map[string]any{"Title": "About"})
	})
	// The items pages show the navigation conventions (docs/lidza-guide.md,
	// "Navigation"): the list's filter is a search parameter
	// (/items?category=seating), an item has a path by its slug
	// (/items/desk-lamp) and each tab one of its own (/items/desk-lamp/specs).
	// Replace them with the app's own.
	mux.HandleFunc("GET /items", func(w http.ResponseWriter, r *http.Request) {
		category := r.URL.Query().Get("category")
		var shown []item
		for _, it := range sampleItems() {
			if category == "" || it.Category == category {
				shown = append(shown, it)
			}
		}
		renderPage(w, "items", map[string]any{"Title": "Items", "Category": category, "Categories": []string{"lighting", "seating", "storage"}, "Items": shown})
	})
	itemPage := func(tab string) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			it, ok := findItem(r.PathValue("slug"))
			if !ok {
				// An unknown slug is a page too, with status 404 and a
				// link to the parent.
				renderPageStatus(w, http.StatusNotFound, "item", map[string]any{"Title": "Not found"})
				return
			}
			title := it.Name
			if tab == "specs" {
				title = "Specs · " + it.Name
			}
			renderPage(w, "item", map[string]any{"Title": title, "Item": it, "Tab": tab})
		}
	}
	mux.HandleFunc("GET /items/{slug}", itemPage("overview"))
	mux.HandleFunc("GET /items/{slug}/specs", itemPage("specs"))
	// A partial calls the same handler function as the JSON API, so the
	// HTML and the API cannot disagree.
	mux.HandleFunc("GET /partials/hello", func(w http.ResponseWriter, r *http.Request) {
		name := r.URL.Query().Get("name")
		if name == "" {
			name = "world"
		}
		r.SetPathValue("name", name)
		greeting, err := hello(r.Context(), &router.Request[router.None]{Raw: r})
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		renderPartial(w, "hello.html", greeting)
	})
	return mux
}

// analyticsEnabled turns on the browser reporter (static/analytics.js):
// errors and pageviews go to the analytics pack. ANALYTICS_FRONTEND=1 in
// .env; nothing is sent otherwise.
var analyticsEnabled = os.Getenv("ANALYTICS_FRONTEND") == "1"

// item is a sample row for the items pages; an app reads its rows
// through the same handler functions as its JSON API.
type item struct {
	Slug, Name, Category, Summary string
	Specs                         [][2]string
}

func sampleItems() []item {
	return []item{
		{"desk-lamp", "Desk lamp", "lighting", "An adjustable lamp for one desk.", [][2]string{{"Height", "45 cm"}, {"Bulb", "E27"}}},
		{"floor-lamp", "Floor lamp", "lighting", "A tall lamp that lights a corner.", [][2]string{{"Height", "160 cm"}, {"Bulb", "E27"}}},
		{"oak-chair", "Oak chair", "seating", "A chair in solid oak.", [][2]string{{"Seat height", "46 cm"}, {"Wood", "Oak"}}},
		{"low-stool", "Low stool", "seating", "A stool that stacks.", [][2]string{{"Seat height", "30 cm"}, {"Stacks", "Up to 6"}}},
		{"wall-shelf", "Wall shelf", "storage", "One shelf on two brackets.", [][2]string{{"Width", "80 cm"}, {"Load", "15 kg"}}},
	}
}

func findItem(slug string) (item, bool) {
	for _, it := range sampleItems() {
		if it.Slug == slug {
			return it, true
		}
	}
	return item{}, false
}

// appName follows each page's own title in the document title
// ("Specs · Desk lamp · app").
const appName = "__LIDZA_APP_NAME__"

func renderPage(w http.ResponseWriter, name string, data map[string]any) {
	renderPageStatus(w, http.StatusOK, name, data)
}

func renderPageStatus(w http.ResponseWriter, status int, name string, data map[string]any) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.WriteHeader(status)
	data["Analytics"] = analyticsEnabled
	data["AppName"] = appName
	if err := pageTemplates[name].ExecuteTemplate(w, "layout", data); err != nil {
		slog.Error("render page", "page", name, "error", err)
	}
}

func renderPartial(w http.ResponseWriter, name string, data any) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	if err := partials.ExecuteTemplate(w, name, data); err != nil {
		slog.Error("render partial", "partial", name, "error", err)
	}
}

// Data shapes for notes: the single source for Go structs (schema/),
// the Postgres DDL and migrations (db/), and the client types. Run
// `lidza gen` after editing; `lidza dev` does it on save.
//
// model: a table and a struct. type: an API shape. enum: a fixed set.

// Types of the auth pack.
model AuthSession @table("auth_session") {
  id          string @id
  subject     string @index
  refreshHash string @unique
  expiresAt   time
  revokedAt   time?
  createdAt   time   @default(now())
}

// A registered person. The password is stored as an argon2id hash;
// verifiedAt is set when the emailed verification link is used.
model User @table("app_user") {
  id           uuid   @id @default(uuid())
  email        string @unique @min(3) @max(200)
  passwordHash string
  verifiedAt   time?
  createdAt    time   @default(now())
}

// A note belongs to the user who created it.
model Note {
  id        uuid    @id @default(uuid())
  ownerId   uuid    @index
  title     string  @min(1) @max(200)
  body      string?
  createdAt time    @default(now())
}


// Body of POST /api/v1/notes. The owner is the signed-in user.
type CreateNote {
  title string  @min(1) @max(200)
  body  string?
}

// Body of PATCH /api/v1/notes/{id}: every field optional, absent fields keep their value.
type UpdateNote {
  title string? @min(1) @max(200)
  body  string?
}

// Reply of GET /api/v1/notes.
type NoteList {
  items Note[]
  total int
}

// Body of POST /api/v1/auth/register and /api/v1/auth/login.
type Credentials {
  email    string @email @max(200)
  password string @min(8) @max(200)
}

// Who is signed in. Browsers get the session as cookies; other clients
// send accessToken as a bearer token.
type Session {
  userId      uuid
  email       string
  verified    bool
  accessToken string
}

// Body of POST /api/v1/auth/verify: the token from the emailed link.
type VerifyEmail {
  token string @min(1)
}

// Body of POST /api/v1/auth/forgot: where to send the reset link.
type ForgotPassword {
  email string @email @max(200)
}

// Body of POST /api/v1/auth/reset: the token from the emailed link and
// the new password.
type ResetPassword {
  token    string @min(1)
  password string @min(8) @max(200)
}

// Reply of GET /api/v1/auth/session: the signed-in user, or null for a
// visitor. A 200 either way, so a page can ask without an error.
type SessionState {
  user Session?
}

// Input of the stats pack's text_stats capability (Rust, packs/stats).
type TextStatsInput {
  text string @max(100000)
  top  int?
}

// Word statistics of a text: reply of GET /api/v1/notes/{id}/stats.
type TextStats {
  words          int
  unique         int
  readingMinutes float
  topWords       WordCount[]
}

type WordCount {
  word  string
  count int
}

model AuthToken @table("auth_token") {
  id        string @id
  purpose   string @index
  subject   string @index
  hash      string @unique
  expiresAt time
  usedAt    time?
  createdAt time   @default(now())
}

// Types of the mail pack.
// Types of the mail pack: the outbox, one row per message sent or queued.
model MailMessage @table("mail_message") {
  id         uuid   @id @default(uuid())
  recipient  string @index
  subject    string
  text       text?
  html       text?
  template   string?
  status     string @index
  providerId string?
  error      text?
  attempts   int
  createdAt  time   @default(now()) @index
  sentAt     time?
}

# systemd unit for {{.Name}}: install the binary and its files under
# /opt/{{.Name}} (bin/{{.Name}}, db/, .env with LIDZA_ADDR, DATABASE_URL, the
# secrets), then:
#   sudo useradd --system --home /opt/{{.Name}} --shell /usr/sbin/nologin {{.Name}}
#   sudo cp deploy/{{.Name}}.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now {{.Name}}
# TLS: set LIDZA_TLS_DOMAINS in .env and the binary serves 443 itself with
# Let's Encrypt certificates (the capability below lets it bind 80 and 443),
# or put a TLS-terminating reverse proxy in front (docs/lidza-guide.md,
# "Deployment").
[Unit]
Description={{.Name}} (Līdza app)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User={{.Name}}
Group={{.Name}}
WorkingDirectory=/opt/{{.Name}}
EnvironmentFile=/opt/{{.Name}}/.env
ExecStart=/opt/{{.Name}}/bin/{{.Name}}
Restart=always
RestartSec=2
# Hardening: the app writes nothing but logs to stdout.
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/{{.Name}}

[Install]
WantedBy=multi-user.target
